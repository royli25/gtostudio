NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Keep this out of browser/client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: set this to a table name if you want /api/supabase/health to run a real DB query.
SUPABASE_HEALTH_TABLE=solution_configs
